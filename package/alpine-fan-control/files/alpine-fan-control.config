# Fan curve: min 55°C/20% -> max 70°C/70%. Fan off below 52°C (min_temp - temp_hyst).
# temp_hyst 3°C reduces speed hunting on small temperature swings.

config alpine-fan-control
	option enable     '1'
	option debug      '0'
	option min_temp   '55'
	option min_speed  '20'
	option max_temp   '70'
	option max_speed  '70'
	option interval   '5'
	option temp_hyst  '3'
	option tmp_sens   'cpu0'
	option fan_cont   'emc230'
	option drv_speed_min '50'
	option drv_speed_start '120'
	option drv_speed_max '255'
	# pwm_method: 'sysfs' (kernel hwmon) or 'i2c' (direct I2C, AX9000 recommended).
	option pwm_method 'i2c'
	option disable_thermal '0'
	option i2c_bus   '0'
	option i2c_addr  '0x2f'
	option i2c_reg   '0x30'
