# Fan curve: three temperature/speed points (speeds are percent 0-100).
# min_temp/min_speed, med_temp/med_speed, max_temp/max_speed - curve points.
# temp_hyst: fan off below (min_temp - temp_hyst); hysteresis on speed decrease.
# drv_speed_min: minimum PWM (0-65535); below this the fan is turned off.
# drv_speed_max: PWM for 100% speed (16-bit, 1-65535; default 255 for EMC230).

config alpine-fan-control
	option enable     '1'
	option debug      '0'
	option min_temp   '45'
	option min_speed  '40'
	option med_temp   '50'
	option med_speed  '60'
	option max_temp   '55'
	option max_speed  '100'
	option interval   '5'
	option temp_hyst  '2'
	option tmp_sens   'cpu0'
	option fan_cont   'emc230'
	option drv_speed_min '60'
	option drv_speed_max '255'
