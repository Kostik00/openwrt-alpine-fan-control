fan_control=$(uci -q get alpine-fan-control.@alpine-fan-control[0])
if [ -z "$fan_control" ]; then
	uci set alpine-fan-control.@alpine-fan-control[0].enable="1"
	uci set alpine-fan-control.@alpine-fan-control[0].debug="0"
	uci set alpine-fan-control.@alpine-fan-control[0].min_temp="55"
	uci set alpine-fan-control.@alpine-fan-control[0].min_speed="20"
	uci set alpine-fan-control.@alpine-fan-control[0].max_temp="70"
	uci set alpine-fan-control.@alpine-fan-control[0].max_speed="70"
	uci set alpine-fan-control.@alpine-fan-control[0].interval="5"
	uci set alpine-fan-control.@alpine-fan-control[0].temp_hyst="3"
	uci set alpine-fan-control.@alpine-fan-control[0].tmp_sens="cpu0"
	uci set alpine-fan-control.@alpine-fan-control[0].fan_cont="emc230"
	uci set alpine-fan-control.@alpine-fan-control[0].drv_speed_min="50"
	uci set alpine-fan-control.@alpine-fan-control[0].drv_speed_start="120"
	uci set alpine-fan-control.@alpine-fan-control[0].drv_speed_max="255"
	uci set alpine-fan-control.@alpine-fan-control[0].pwm_method="i2c"
	uci set alpine-fan-control.@alpine-fan-control[0].disable_thermal="0"
	uci set alpine-fan-control.@alpine-fan-control[0].i2c_bus="0"
	uci set alpine-fan-control.@alpine-fan-control[0].i2c_addr="0x2f"
	uci set alpine-fan-control.@alpine-fan-control[0].i2c_reg="0x30"

	uci commit alpine-fan-control
fi
