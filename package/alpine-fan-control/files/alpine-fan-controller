#!/bin/sh

. /lib/functions.sh

CFGNAME=alpine-fan-control

function get_opt() {
	local opt_name=$1
	local def_value=$2
	local config="@$CFGNAME[0]"
	echo "$( uci_get $CFGNAME "$config" $opt_name $def_value )"
}

# Fan curve: two points (min_temp/min_speed, max_temp/max_speed).
# Speed is linearly interpolated between them.
#
# min_temp  - fan turn-on threshold; fan runs at T >= min_temp
# min_speed - fan speed (%) at min_temp
# max_temp  - upper curve point; above max_temp, fan runs at 100%
# max_speed - fan speed (%) at max_temp (end of linear segment)
#
# temp_hyst - hysteresis (Celsius): fan off below (min_temp - temp_hyst);
#             speed increases apply immediately; speed decreases apply only
#             after temperature drops by temp_hyst since the last speed change
# interval  - temperature polling interval (seconds)
# debug     - log debug messages to syslog
#
# tmp_sens  - thermal zone type name (sysfs: thermal_zone*/type)
# fan_cont  - hwmon device name (sysfs: hwmon*/name, pwm1 is used)
#
# drv_speed_min - minimum PWM (0-65535); if calculated PWM is below this, fan off
# drv_speed_max - PWM value for 100% speed (16-bit, 1-65535; default 255 for EMC230)
# drv_speed_start - kickstart PWM when fan spins up from 0; also used for startup fan test
#
# pwm_method - PWM output method: 'sysfs' (kernel hwmon) or 'i2c' (direct I2C via i2cset).
#              i2c bypasses kernel thermal PWM quantization on EMC230 when max_state=10. Requires i2c-tools.
# i2c_bus, i2c_addr, i2c_reg - I2C path to Fan Drive Setting (AX9000: bus 0, 0x2f, 0x30)
# disable_thermal - disable EMC2305 kernel thermal zones to prevent kernel from overwriting I2C PWM
# At startup: PWM=drv_speed_start, verify fan RPM, then enter main loop (first interpolate after interval)
# If startup test fails, or PWM>0 with RPM=0 for STARTUP_RPM_ATTEMPTS cycles: emergency mode -
# PWM set to drv_speed_max and verified; if fan still does not spin, PWM=0
# STARTUP_RPM_ATTEMPTS - RPM check attempts at startup/emergency test; also stall counter limit

STARTUP_RPM_ATTEMPTS=5
STARTUP_RPM_WAIT=1

TEMP_MIN=$(  get_opt min_temp  55 )
SPEED_MIN=$( get_opt min_speed 20 )

TEMP_MAX=$(  get_opt max_temp  70 )
SPEED_MAX=$( get_opt max_speed 70 )

TEMP_SENSOR=$( get_opt tmp_sens cpu0  )
FAN_CONT=$(    get_opt fan_cont emc230 )

HYSTERESIS=$( get_opt temp_hyst 3 )
SLEEP_INTERVAL=$( get_opt interval 5 )
DEBUG=$( get_opt debug 0 )

DRV_SPEED_MIN=$( get_opt drv_speed_min 50 )
DRV_SPEED_START=$( get_opt drv_speed_start 120 )
DRV_SPEED_MAX=$( get_opt drv_speed_max 255 )
PWM_METHOD=$( get_opt pwm_method sysfs )
I2C_BUS=$( get_opt i2c_bus 0 )
I2C_ADDR=$( get_opt i2c_addr 0x2f )
I2C_REG=$( get_opt i2c_reg 0x30 )
DISABLE_THERMAL=$( get_opt disable_thermal 0 )
CFG_SPEED_MAX=100
PWM_MAX=65535

LOGPREFIX="alpine-fan-controller"
TEMP_AT_LAST_SPEED_CHANGE=
LAST_APPLIED_SPEED=
FAN_ON=
EMERGENCY_MODE=0
EMERGENCY_FAN_STOPPED=0
STALL_COUNT=0
SENSOR_TEMP=
SENSOR_PWM=
SENSOR_RPM=

function log_error {
	logger "$LOGPREFIX: ERROR: $1"
}

function log_warning {
	logger "$LOGPREFIX: WARNING: $1"
}

function log_debug {
	if [ "$DEBUG" = "1" ]; then
		logger "$LOGPREFIX: $1"
	fi
}

function read_pwm_hw {
	local raw

	if [ "$PWM_METHOD" = "i2c" ]; then
		raw=$( i2cget -f -y "$I2C_BUS" "$I2C_ADDR" "$I2C_REG" 2>/dev/null ) || return 1
		echo $(( raw ))
		return 0
	fi

	cat $FILE_SPEED 2>/dev/null
}

function write_pwm_hw {
	local value=$1

	if [ "$PWM_METHOD" = "i2c" ]; then
		i2cset -f -y "$I2C_BUS" "$I2C_ADDR" "$I2C_REG" "$value" 2>/dev/null
		return $?
	fi

	echo $value > $FILE_SPEED
}

function disable_kernel_fan_thermal {
	local tz c target type cdev_dir

	for tz in /sys/class/thermal/thermal_zone*; do
		for c in "$tz"/cdev*; do
			[ -e "$c" ] || continue
			target=$( readlink -f "$c" 2>/dev/null ) || continue
			cdev_dir=$( dirname "$target" )
			[ -f "$cdev_dir/type" ] || continue
			type=$( cat "$cdev_dir/type" 2>/dev/null )
			echo "$type" | grep -q emc2305 || continue
			echo disabled > "$tz/mode" 2>/dev/null && \
				log_debug "disabled $(basename "$tz") ($type)"
		done
	done
}

function read_sensors {
	SENSOR_TEMP=$( cat $FILE_TEMP 2>/dev/null )
	SENSOR_TEMP=${SENSOR_TEMP:-0}
	SENSOR_PWM=$( read_pwm_hw 2>/dev/null )
	SENSOR_PWM=${SENSOR_PWM:-0}
	SENSOR_RPM=$( cat $FILE_RPM 2>/dev/null )
	SENSOR_RPM=${SENSOR_RPM:-0}
}

function sensor_status {
	echo "temp=$(( SENSOR_TEMP / 1000 ))°C PWM=$SENSOR_PWM RPM=$SENSOR_RPM"
}

function log_with_sensors {
	log_debug "$1 ($(sensor_status))"
}

function check_fan_stall {
	if [ "$SENSOR_PWM" -le 0 ] 2>/dev/null || [ "$SENSOR_RPM" -gt 0 ] 2>/dev/null; then
		STALL_COUNT=0
		return 0
	fi

	STALL_COUNT=$(( STALL_COUNT + 1 ))
	log_debug "fan stall count $STALL_COUNT/$STARTUP_RPM_ATTEMPTS ($(sensor_status))"

	if [ "$STALL_COUNT" -ge "$STARTUP_RPM_ATTEMPTS" ]; then
		STALL_COUNT=0
		enter_emergency_mode "fan stall detected: PWM=$SENSOR_PWM but RPM=0 for $STARTUP_RPM_ATTEMPTS cycles ($(sensor_status))"
		return 1
	fi
	return 0
}

function validate_range {
	local name=$1
	local value=$2
	local min=$3
	local max=$4

	if [ -z "$value" ] || [ "$value" -lt "$min" ] || [ "$value" -gt "$max" ]; then
		log_error "$name must be between $min and $max"
		exit 1
	fi
}

if [ -z "$TEMP_MIN" ] || [ -z "$TEMP_MAX" ]; then
	log_error "Cannot read temperature options from config!"
	exit 1
fi

validate_range "min_temp" "$TEMP_MIN" 1 150
validate_range "max_temp" "$TEMP_MAX" 1 150

validate_range "min_speed" "$SPEED_MIN" 0 $CFG_SPEED_MAX
validate_range "max_speed" "$SPEED_MAX" 0 $CFG_SPEED_MAX

validate_range "interval" "$SLEEP_INTERVAL" 1 3600
validate_range "temp_hyst" "$HYSTERESIS" 0 99
validate_range "drv_speed_max" "$DRV_SPEED_MAX" 1 $PWM_MAX
validate_range "drv_speed_min" "$DRV_SPEED_MIN" 0 $PWM_MAX
validate_range "drv_speed_start" "$DRV_SPEED_START" 0 $PWM_MAX
validate_range "debug" "$DEBUG" 0 1

if [ "$PWM_METHOD" != "sysfs" ] && [ "$PWM_METHOD" != "i2c" ]; then
	log_error "pwm_method must be 'sysfs' or 'i2c'"
	exit 1
fi

if [ "$PWM_METHOD" = "i2c" ]; then
	validate_range "i2c_bus" "$I2C_BUS" 0 99
fi

if [ "$TEMP_MIN" -ge "$TEMP_MAX" ]; then
	log_error "Temperature thresholds must satisfy min_temp < max_temp"
	exit 1
fi

if [ "$SPEED_MIN" -gt "$SPEED_MAX" ]; then
	log_error "Fan speeds must satisfy min_speed <= max_speed"
	exit 1
fi

if [ "$HYSTERESIS" -ge "$TEMP_MIN" ]; then
	log_error "temp_hyst must be less than min_temp"
	exit 1
fi

if [ "$DRV_SPEED_MIN" -gt "$DRV_SPEED_MAX" ]; then
	log_error "drv_speed_min must not exceed drv_speed_max"
	exit 1
fi

MIN_SPEED_PWM=$(( DRV_SPEED_MAX * SPEED_MIN / CFG_SPEED_MAX ))
if [ "$SPEED_MIN" -gt 0 ] && [ "$MIN_SPEED_PWM" -gt 0 ] && [ "$MIN_SPEED_PWM" -lt "$DRV_SPEED_MIN" ]; then
	log_warning "min_speed ${SPEED_MIN}% maps to PWM=$MIN_SPEED_PWM, below drv_speed_min=$DRV_SPEED_MIN - fan off at min_temp until curve PWM reaches minimum"
fi

# checking for privileges
if [ $UID -ne 0 ]; then
	log_error "Writing to sysfs requires privileges, relaunch as root!"
	echo "Writing to sysfs requires privileges, relaunch as root"
	exit 1
fi

OPTLIST=""
OPTLIST="$OPTLIST [$TEMP_MIN $SPEED_MIN]"
OPTLIST="$OPTLIST [$TEMP_MAX $SPEED_MAX]"
OPTLIST="$OPTLIST $HYSTERESIS $SLEEP_INTERVAL $DEBUG"
OPTLIST="$OPTLIST $TEMP_SENSOR $FAN_CONT"
[ "$PWM_METHOD" = "i2c" ] && OPTLIST="$OPTLIST i2c($I2C_BUS $I2C_ADDR $I2C_REG)"

# Perform conversion to millidegrees Celsius
TEMP_MIN=$(( $TEMP_MIN * 1000 ))
TEMP_MAX=$(( $TEMP_MAX * 1000 ))
HYSTERESIS=$(( $HYSTERESIS * 1000 ))
TEMP_OFF=$(( $TEMP_MIN - $HYSTERESIS ))
[ $TEMP_OFF -lt 0 ] && TEMP_OFF=0

FILE_HWMON=$( grep -l -F $FAN_CONT /sys/class/hwmon/hwmon*/name 2>/dev/null )
[ -f "$FILE_HWMON" ] || { log_error "fan controller $FAN_CONT not found" ; exit 1; }
HWMON_DIR=$( dirname "$FILE_HWMON" )
FILE_SPEED=$HWMON_DIR/pwm1
FILE_RPM=$HWMON_DIR/fan1_input
[ -f "$FILE_SPEED" ] || { log_error "fan PWM $FILE_SPEED not found" ; exit 1; }
[ -f "$FILE_RPM" ] || { log_error "fan tachometer $FILE_RPM not found" ; exit 1; }

FILE_THERMAL=$( grep -l -F $TEMP_SENSOR /sys/class/thermal/thermal_zone*/type 2>/dev/null )
[ -f "$FILE_THERMAL" ] || { log_error "thermal sensor $TEMP_SENSOR not found" ; exit 1; }
FILE_TEMP=$( dirname "$FILE_THERMAL" )/temp
[ -f "$FILE_TEMP" ] || { log_error "thermal sensor temp $FILE_TEMP not found" ; exit 1; }

function pwm_to_speed {
	local pwm=$1

	[ -z "$pwm" ] || [ "$pwm" -le 0 ] && { echo 0; return; }
	echo $(( CFG_SPEED_MAX * pwm / DRV_SPEED_MAX ))
}

function speed_to_pwm {
	local speed=$1
	local value

	[ "$speed" -le 0 ] && { echo 0; return; }
	value=$(( $DRV_SPEED_MAX * $speed / $CFG_SPEED_MAX ))
	[ $value -lt $DRV_SPEED_MIN ] && { echo 0; return; }
	[ $value -gt $DRV_SPEED_MAX ] && value=$DRV_SPEED_MAX
	[ $value -gt $PWM_MAX ] && value=$PWM_MAX
	echo $value
}

function applied_speed {
	local speed=$1
	local pwm

	pwm=$( speed_to_pwm $speed )
	[ "$pwm" -eq 0 ] && { echo 0; return; }
	echo $speed
}

function internal_set_pwm {
	local value=$1
	local requested=$value
	local actual

	[ $value -lt 0 ] && value=0
	[ $value -gt $DRV_SPEED_MAX ] && value=$DRV_SPEED_MAX
	[ $value -gt $PWM_MAX ] && value=$PWM_MAX
	requested=$value

	if [ $value -gt 0 ]; then
		if [ "$SENSOR_PWM" -le 0 ] 2>/dev/null && [ "$value" -ne "$DRV_SPEED_START" ]; then
			log_debug "fan kickstart from stop: $( pwm_to_speed $DRV_SPEED_START )% (PWM=$DRV_SPEED_START) for ${STARTUP_RPM_WAIT}s"
			write_pwm_hw $DRV_SPEED_START
			SENSOR_PWM=$DRV_SPEED_START
			sleep $STARTUP_RPM_WAIT
		fi
	fi

	write_pwm_hw $value || log_error "failed to set PWM=$value"
	actual=$( read_pwm_hw 2>/dev/null )
	actual=${actual:-$value}
	SENSOR_PWM=$actual

	if [ "$actual" != "$requested" ]; then
		log_debug "PWM read-back: requested $requested, applied $actual ($( pwm_to_speed $actual )%)"
	fi
}

function wait_for_fan_rpm {
	local context=$1
	local attempt=1

	while [ $attempt -le $STARTUP_RPM_ATTEMPTS ]; do
		sleep $STARTUP_RPM_WAIT
		read_sensors
		log_debug "$context: attempt $attempt/$STARTUP_RPM_ATTEMPTS RPM=$SENSOR_RPM"
		if [ "$SENSOR_RPM" -gt 0 ] 2>/dev/null; then
			echo $SENSOR_RPM
			return 0
		fi
		attempt=$(( attempt + 1 ))
	done
	echo 0
	return 1
}

function startup_fan_test {
	local rpm

	logger "$LOGPREFIX: startup fan test: $( pwm_to_speed $DRV_SPEED_START )% (PWM=$DRV_SPEED_START), up to $STARTUP_RPM_ATTEMPTS attempts, ${STARTUP_RPM_WAIT}s each"
	internal_set_pwm $DRV_SPEED_START

	rpm=$( wait_for_fan_rpm "startup fan test" )
	if [ "$rpm" -le 0 ] 2>/dev/null; then
		enter_emergency_mode "startup fan test failed: no rotation at PWM=$DRV_SPEED_START after $STARTUP_RPM_ATTEMPTS attempts"
		return 1
	fi

	logger "$LOGPREFIX: startup fan test passed at RPM=$rpm"
	return 0
}

function enter_emergency_mode {
	local reason=$1
	local rpm

	EMERGENCY_MODE=1
	EMERGENCY_FAN_STOPPED=0
	log_error "$reason"
	logger "$LOGPREFIX: ERROR: Entering fan emergency mode - PWM=$DRV_SPEED_MAX, temperature control disabled"
	internal_set_pwm $DRV_SPEED_MAX

	logger "$LOGPREFIX: emergency fan test: PWM=$DRV_SPEED_MAX, up to $STARTUP_RPM_ATTEMPTS attempts, ${STARTUP_RPM_WAIT}s each"
	rpm=$( wait_for_fan_rpm "emergency fan test" )
	if [ "$rpm" -le 0 ] 2>/dev/null; then
		EMERGENCY_FAN_STOPPED=1
		log_error "emergency fan test failed: no rotation at PWM=$DRV_SPEED_MAX after $STARTUP_RPM_ATTEMPTS attempts"
		logger "$LOGPREFIX: ERROR: Emergency fan test failed - stopping fan (PWM=0)"
		internal_set_pwm 0
		return
	fi

	logger "$LOGPREFIX: emergency fan test passed at RPM=$rpm"
}

function log_emergency_warning {
	if [ "$EMERGENCY_FAN_STOPPED" = "1" ]; then
		logger "$LOGPREFIX: WARNING: Fan emergency mode - fan stopped (PWM=0), temperature control disabled"
	else
		logger "$LOGPREFIX: WARNING: Fan emergency mode active - PWM locked at $DRV_SPEED_MAX, temperature control disabled"
	fi
}

function internal_set_speed {
	internal_set_pwm $( speed_to_pwm $1 )
}

function set_speed {
	local NEW_SPEED=$1
	local interpolated=$2
	local force=$3
	local TEMP=$4
	local tmp cur_speed EFFECTIVE new_pwm applied_pwm

	EFFECTIVE=$( applied_speed $NEW_SPEED )
	new_pwm=$( speed_to_pwm $NEW_SPEED )
	applied_pwm=$( speed_to_pwm $EFFECTIVE )
	cur_speed=$( pwm_to_speed $SENSOR_PWM )

	if [ "$force" = "1" ]; then
		[ "$EFFECTIVE" = "$LAST_APPLIED_SPEED" ] && [ "$SENSOR_PWM" = "$new_pwm" ] && return
		log_with_sensors "forced speed change to ${NEW_SPEED}% (PWM=$new_pwm), current ${cur_speed}%"
		internal_set_speed $NEW_SPEED
		LAST_APPLIED_SPEED=$EFFECTIVE
		TEMP_AT_LAST_SPEED_CHANGE=$TEMP
		return
	fi

	[ "$EFFECTIVE" = "$LAST_APPLIED_SPEED" ] && [ "$SENSOR_PWM" = "$new_pwm" ] && return

	if [ "$DEBUG" = "1" ]; then
		log_with_sensors "current ${cur_speed}%, requested ${NEW_SPEED}% (PWM=$new_pwm)"
		[ "$interpolated" = "1" ] && log_with_sensors "interpolated speed ${NEW_SPEED}% (PWM=$new_pwm)"
	fi

	# speed increase: apply immediately (no hysteresis)
	if [ -z "$LAST_APPLIED_SPEED" ] || [ "$NEW_SPEED" -gt "$LAST_APPLIED_SPEED" ]; then
		log_with_sensors "speed increase ${LAST_APPLIED_SPEED}% -> ${NEW_SPEED}% (PWM=$applied_pwm)"
		internal_set_speed $NEW_SPEED
		LAST_APPLIED_SPEED=$EFFECTIVE
		[ "$EFFECTIVE" != "$NEW_SPEED" ] && log_with_sensors "PWM below minimum, fan off instead of ${NEW_SPEED}% (PWM=$new_pwm)"
		TEMP_AT_LAST_SPEED_CHANGE=$TEMP
		return
	fi

	# speed decrease: apply only after temperature drops by hysteresis
	tmp=$TEMP_AT_LAST_SPEED_CHANGE
	if [ -z "$tmp" ] || [ $(( TEMP + HYSTERESIS )) -le "$tmp" ]; then
		log_with_sensors "speed decrease ${LAST_APPLIED_SPEED}% -> ${NEW_SPEED}% (PWM=$applied_pwm), last change at temp $tmp"
		internal_set_speed $NEW_SPEED
		LAST_APPLIED_SPEED=$EFFECTIVE
		[ "$EFFECTIVE" != "$NEW_SPEED" ] && log_with_sensors "PWM below minimum, fan off instead of ${NEW_SPEED}% (PWM=$new_pwm)"
		TEMP_AT_LAST_SPEED_CHANGE=$TEMP
	else
		log_with_sensors "speed decrease held by hysteresis, current ${LAST_APPLIED_SPEED}%, need temp <= $(( tmp - HYSTERESIS ))"
	fi
}

function set_speed_adv {
	# interpolate linearly
	local LOWERTEMP=$1
	local LOWERSPEED=$2
	local HIGHERTEMP=$3
	local HIGHERSPEED=$4
	local TEMP=$5
	local span value SPEED

	span=$(( $HIGHERTEMP - $LOWERTEMP ))
	value=$(( ( $TEMP - $LOWERTEMP ) * ( $HIGHERSPEED - $LOWERSPEED ) ))
	SPEED=$(( ( $value + $span / 2 ) / $span + $LOWERSPEED ))
	set_speed "$SPEED" 1 "" "$TEMP"
}

function interpolate_speed {
	read_sensors
	local TEMP=$SENSOR_TEMP

	log_with_sensors "sensors"

	check_fan_stall || return

	if [ $TEMP -lt $TEMP_OFF ]; then
		# fan off below (min_temp - temp_hyst)
		FAN_ON=0
		set_speed 0 "" 1 "$TEMP"
		return
	fi

	if [ $TEMP -ge $TEMP_MIN ]; then
		# fan on at min_temp and above
		FAN_ON=1
	elif [ -z "$FAN_ON" ]; then
		FAN_ON=0
	fi

	if [ "$FAN_ON" != "1" ]; then
		# hysteresis zone between TEMP_OFF and TEMP_MIN: keep previous on/off state
		set_speed 0 "" 1 "$TEMP"
		return
	fi

	if [ $TEMP -gt $TEMP_MAX ]; then
		# above max_temp: full fan speed (100%)
		set_speed $CFG_SPEED_MAX "" "" "$TEMP"
		return
	fi
	if [ $TEMP -ge $TEMP_MIN ]; then
		set_speed_adv $TEMP_MIN $SPEED_MIN $TEMP_MAX $SPEED_MAX $TEMP
		return
	fi
	# fan still on in hysteresis zone below min_temp
	set_speed $SPEED_MIN "" "" "$TEMP"
}

function reset_on_exit {
	echo "exiting, going to max fan speed for safety..."
	internal_set_speed 100
	exit 0
}

# always try to reset fans on exit
trap "reset_on_exit" SIGINT SIGTERM

function run_daemon {
	while true; do
		sleep $SLEEP_INTERVAL
		if [ "$EMERGENCY_MODE" = "1" ]; then
			log_emergency_warning
		else
			interpolate_speed
		fi
	done
}

logger "$LOGPREFIX: run daemon:" $OPTLIST

if [ "$PWM_METHOD" = "i2c" ]; then
	command -v i2cset >/dev/null 2>&1 || { log_error "pwm_method=i2c requires i2cset (package i2c-tools)"; exit 1; }
	command -v i2cget >/dev/null 2>&1 || { log_error "pwm_method=i2c requires i2cget (package i2c-tools)"; exit 1; }
	logger "$LOGPREFIX: pwm_method=i2c: bus=$I2C_BUS addr=$I2C_ADDR reg=$I2C_REG"
	if [ "$DISABLE_THERMAL" = "1" ]; then
		disable_kernel_fan_thermal
		logger "$LOGPREFIX: EMC2305 kernel thermal zones disabled"
	fi
fi

read_sensors
startup_fan_test
run_daemon
